# ----------------------------------------
# 🎯 REGLAS GENERALES DEL MONOREPO (NUTRI-APP)
# ----------------------------------------

# IDE/OS
.DS_Store          # Archivos de metadatos de macOS
.idea/             # Configuración de IDE (Android Studio, IntelliJ, WebStorm)
*.pem              # Certificados (usualmente temporales/privados)

# Logs de debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ENV (archivos de entorno, generalmente contienen secretos)
.env*
.vercel             # Configuración de Vercel (si se usa)

# ----------------------------------------
# 📦 DEPENDENCIAS Y NODE.JS (Web y Raíz)
# ----------------------------------------

# Ignora las carpetas node_modules donde sea que estén
/node_modules
/web/node_modules
/mobile/node_modules

# Yarn PnP y caché
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Typescript
*.tsbuildinfo
next-env.d.ts

# ----------------------------------------
# 🌐 PROYECTO WEB (NEXT.JS)
# ----------------------------------------

# Carpetas de Next.js. El primero ignora si está en la raíz, el segundo en el subproyecto.
/.next/
/web/.next/
/out/
/web/out/

# Compilación de producción
/build
/web/build

# Testing
/coverage

# ----------------------------------------
# 📱 PROYECTO MOBILE (ANDROID)
# ----------------------------------------

# Android Studio / Gradle
/mobile/.gradle
/mobile/local.properties
/mobile/app/build
/mobile/app/.cxx
/mobile/app/.externalNativeBuild